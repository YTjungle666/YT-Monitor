# /etc/ytmon/server.toml —— ytmon 中心配置
# 缺省时服务器使用内置默认值（只监听 9180，不启用 discovery/probe）。

listen = "0.0.0.0:9180"
db = "/var/lib/ytmon/ytmon.db"

# --- PVE 只读发现：让"所有 CT/VM"包含没装 agent 的机器 ---
pve_base = "https://pve.example.com:8006"
pve_node = "pve"
pve_token_file = "/etc/ytmon/pve.token"
pve_interval_secs = 300
# 从 PVE 删除的 guest，确认缺席这么久后连同历史一起清理（0 = 关闭）
pve_prune_absent_secs = 600

# --- 主动探测：覆盖 Windows VM / SSH 未开的 NAS ---
probe_interval_secs = 60

[[probes]]
name = "win-desk"
kind = "tcp"
addr = "192.0.2.20:3389"
timeout_secs = 4

[[probes]]
name = "nas"
kind = "icmp"
addr = "192.0.2.30"
timeout_secs = 3

[[probes]]
name = "nas"
kind = "http"
url = "https://nas.example.com/"
timeout_secs = 5

# --- 每台 agent 一条 ---
# node_id 可省略：省略时按 name 与 agent 上报的 ctid 自动解析。
# 只有 host:pve 这类不在 PVE 清单里的身份必须写 node_id。
# [[agents]]
# name = "web-01"
# token = "..."
#
# [[agents]]
# node_id = "host:pve"
# name = "pve"
# token = "..."
