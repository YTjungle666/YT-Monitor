#!/bin/sh
# yt-upgrade — 每日包升级 + 清缓存
#
# 由 busybox crond 的 `run-parts /etc/periodic/daily` 触发（默认 crontab 里
# 02:00 那一行）。crond 由各容器自己的 PID1 拉起，所以本机不依赖 CT411。
#
# 也可手动执行一次：/etc/periodic/daily/yt-upgrade
#
# 只升级、不重启服务：musl/libc 这类包要等容器下次重启才真正生效。
#
# 顺序很重要：清缓存必须是最后一个碰 apk 的动作。apk 发现索引文件不在，
# 下一次任何 apk 命令（含 `apk version -l`）都会重新下载索引，缓存立刻长回来
# （实测：先 rm 再统计，2.8 MB 又出现，mtime 比 done 还晚）。
#
# 运行身份：PID1 带 lxc.init.uid 的容器（YT-Panel / YT-Sub，uid 100）里 crond
# 也不是 root，apk 会直接拒绝。这类容器装了 sudo 并配好 NOPASSWD 之后，本脚本
# 自己提权重跑一遍，调用方不必关心。

if [ "$(id -u)" != "0" ]; then
    if command -v sudo >/dev/null 2>&1; then
        exec sudo -n "$0" "$@"
    fi
    echo "yt-upgrade: 需要 root，且本机没有 sudo" >&2
    exit 1
fi

LOG=/var/log/yt-upgrade.log

pending() {
    apk version -l "<" 2>/dev/null | tail -n +2 | wc -l
}

{
    echo "=== $(date '+%F %T') start"
    apk update -q 2>&1 | tail -2
    before=$(pending)
    apk upgrade 2>&1 | tail -5
    after=$(pending)
    rm -rf /var/cache/apk/*
    echo "=== $(date '+%F %T') done before=$before after=$after"
} >>"$LOG" 2>&1

# 只留最近 500 行，避免日志无限长（每台每天约 10 行）。
# 原地重写而不是 mv：别的进程可能正追加写这些文件，mv 换掉 inode 后它们的
# 写入会落到看不见的旧 inode 里。
trim() {
    f=$1
    [ -f "$f" ] || return 0
    [ "$(wc -c <"$f")" -gt 262144 ] || return 0
    tail -n 500 "$f" >"$f.tmp" 2>/dev/null && cat "$f.tmp" >"$f" && rm -f "$f.tmp"
}

# 顺带给别的常驻日志封顶：agent 与 crond 的日志不归本脚本写，但没人看着就会一直长
trim "$LOG"
trim /var/log/ytmon-agent.log
trim /var/log/crond.log
